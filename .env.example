# Active provider — the prototype is built and demoed against Anthropic Claude.
LLM_PROVIDER=anthropic

# Required. Must have web search tool access on the account (used by profile_company).
ANTHROPIC_API_KEY=

# Unused placeholders — kept for the provider-agnostic path (see spec.md §7).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: override the default Claude model.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

LOG_LEVEL=INFO
