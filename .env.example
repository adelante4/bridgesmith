# Each agent picks its model independently, defaulting to Luna (gpt-5.6-luna)
# when its env var is unset. Provider is inferred from the model name
# (claude-* -> anthropic, gpt-*/o1-*/o3-* -> openai) — see app/llm.py.
# Uncomment to override any one agent, e.g. back to Anthropic:
# GENERATION_MODEL=claude-sonnet-5
# INGESTION_AGENT_MODEL=claude-sonnet-5
# VISION_MODEL=claude-sonnet-5
# DEEP_RESEARCH_MODEL=claude-sonnet-5

# Provide whichever key(s) your chosen models need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

LOG_LEVEL=INFO

# --- Langfuse (local tracing) ---
# Self-hosted via docker-compose.yml's langfuse-* services. Leave LANGFUSE_*
# unset to disable tracing entirely (app/observability.py no-ops). The
# LANGFUSE_INIT_* vars below auto-provision a project on first `docker compose
# up`, matching LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY so `api` can trace
# immediately, no manual UI signup needed. UI at http://localhost:3000.
# Container-to-container hostname (works when `api` runs via docker compose).
# Running `uvicorn` directly on the host instead? Use http://localhost:3000.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890

LANGFUSE_INIT_ORG_ID=marketing-automation
LANGFUSE_INIT_ORG_NAME=Marketing Automation
LANGFUSE_INIT_PROJECT_ID=marketing-automation
LANGFUSE_INIT_PROJECT_NAME=Marketing Automation
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-1234567890
LANGFUSE_INIT_USER_EMAIL=dev@localhost
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=changeme123
